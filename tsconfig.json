{
	"compilerOptions": {
		"jsx": "react-jsx",
		"moduleSuffixes": [".web", ".native", ""],
		"paths": {
			"@/*": ["./*"]
		},
		"strict": true,
		"types": ["jest"]
	},
	"extends": "expo/tsconfig.base",
	"include": [
		"**/*.ts",
		"**/*.tsx",
		".expo/types/**/*.ts",
		"expo-env.d.ts",
		"nativewind-env.d.ts",
		"env.d.ts"
	]
}
