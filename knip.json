{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"entry": [
		"app/**/*.{ts,tsx}!",
		"shared/**/*.{ts,tsx}!",
		"features/**/*.{ts,tsx}!"
	],
	"ignore": [
		"**/*.web.tsx",
		"**/*.web.ts",
		"**/*.native.tsx",
		"**/*.native.ts",
		"shared/supabase/database.types.ts"
	],
	"ignoreBinaries": ["expo-doctor", "sleep", "eas", "diff", "eas-cli"],
	"ignoreDependencies": [
		"@babel/core",
		"workbox-cli",
		"babel-preset-expo",
		"jest-mock",
		"expo-sharing"
	],
	"ignoreExportsUsedInFile": true,
	"project": ["**/*.{ts,tsx}"]
}
