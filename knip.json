{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"entry": [
		"app/**/*.{ts,tsx}!",
		"shared/**/*.{ts,tsx}!",
		"features/**/*.{ts,tsx}!"
	],
	"ignore": [
		"**/*.web.tsx",
		"**/*.web.ts",
		"**/*.native.tsx",
		"**/*.native.ts",
		"public/sw-template.js",
		"workbox-config.js",
		"babel.config.js",
		"metro.config.js",
		"shared/supabase/database.types.ts"
	],
	"ignoreBinaries": ["expo-doctor", "sleep", "eas", "diff", "eas-cli"],
	"ignoreDependencies": [
		"workbox-cacheable-response",
		"workbox-cli",
		"workbox-expiration",
		"workbox-precaching",
		"workbox-routing",
		"workbox-strategies",
		"babel-preset-expo",
		"metro-minify-terser",
		"jest-mock",
		"expo-sharing"
	],
	"ignoreExportsUsedInFile": true,
	"project": ["**/*.{ts,tsx}"]
}
