{
	"name": "fithacker-app",
	"version": "1.0.0",
	"private": true,
	"main": "expo-router/entry",
	"scripts": {
		"android": "expo run:android",
		"checks": "npm run typecheck && npm run lint:fix && npm run format && npm run test && npx expo-doctor && npx knip && npm run verify:types && npm run supabase:db:diff",
		"checks:ci": "npm run typecheck && npm run lint && npm run format:check && npm run test && npx expo-doctor && npx knip && npm run verify:types",
		"checks:precommit": "npm run lint:fix && npm run format && git add -A && npm run typecheck",
		"deploy:prod": "./scripts/deploy-prod.sh",
		"deploy:schema": "npx supabase db push --linked && sleep 2 && npm run supabase:types",
		"env:pull": "eas env:pull --environment development --path .env",
		"format": "sort-package-json && prettier --write . | grep -v '(unchanged)' || true",
		"format:check": "sort-package-json --check && prettier --check .",
		"postinstall": "patch-package",
		"ios": "expo run:ios",
		"ios:dev": "eas build --profile=development --platform=ios",
		"ios:pre": "eas build --profile=preview --platform=ios",
		"ios:prod": "eas build --platform=ios",
		"ios:sim": "eas build --profile=simulator --platform=ios",
		"ios:submit": "eas submit --platform=ios",
		"ios:update:prod": "eas update --environment production",
		"lint": "expo lint",
		"lint:fix": "expo lint --fix",
		"prepare": "husky",
		"start": "expo start",
		"supabase:db:diff": "npx supabase db diff --linked",
		"supabase:db:reset": "npx supabase db reset --project-id eujlarqrbwllnmxlhbsk",
		"supabase:login": "npx supabase login",
		"supabase:logs:api": "npx supabase projects api-logs --project-id eujlarqrbwllnmxlhbsk",
		"supabase:logs:postgres": "npx supabase projects postgres-logs --project-id eujlarqrbwllnmxlhbsk",
		"supabase:logs:realtime": "npx supabase projects realtime-logs --project-id eujlarqrbwllnmxlhbsk",
		"supabase:migrations": "npx supabase migration list --project-id eujlarqrbwllnmxlhbsk",
		"supabase:schema:diff": "npx supabase db diff --linked -f",
		"supabase:schema:pull": "npx supabase db dump --linked -s public -f supabase/schemas/schema.sql",
		"supabase:status": "npx supabase projects list",
		"supabase:templates:deploy": "bash scripts/deploy-email-templates.sh",
		"supabase:types": "npx supabase gen types typescript --project-id eujlarqrbwllnmxlhbsk > shared/supabase/database.types.ts",
		"test": "jest",
		"test:watch": "jest --watchAll",
		"typecheck": "tsc --noEmit",
		"verify:types": "npx supabase gen types typescript --project-id eujlarqrbwllnmxlhbsk > shared/supabase/database.types.tmp.ts && npx prettier --write shared/supabase/database.types.tmp.ts > /dev/null && npx prettier --write shared/supabase/database.types.ts > /dev/null 2>&1 && diff shared/supabase/database.types.ts shared/supabase/database.types.tmp.ts > /dev/null && rm shared/supabase/database.types.tmp.ts || (rm -f shared/supabase/database.types.tmp.ts && echo '\nError: database.types.ts is out of sync with remote schema.\nRun: npm run supabase:types\n' && exit 1)",
		"web": "expo start --web",
		"web:build": "npx expo export --platform web && npx workbox-cli generateSW workbox-config.js",
		"web:pre": "npm run web:build && npx eas-cli deploy --alias preview",
		"web:prod": "npm run web:build && npx eas-cli deploy --prod",
		"web:serve": "npx serve dist -p 8081 --single"
	},
	"jest": {
		"preset": "jest-expo"
	},
	"dependencies": {
		"@react-native-async-storage/async-storage": "2.2.0",
		"@supabase/supabase-js": "^2.78.0",
		"@tanstack/react-query": "^5.90.12",
		"@tanstack/react-query-devtools": "^5.91.1",
		"expo": "~55.0.26",
		"expo-constants": "~55.0.16",
		"expo-dev-client": "~55.0.35",
		"expo-file-system": "~55.0.22",
		"expo-font": "~55.0.8",
		"expo-linear-gradient": "~55.0.14",
		"expo-linking": "~55.0.15",
		"expo-localization": "~55.0.15",
		"expo-network": "~55.0.14",
		"expo-router": "~55.0.16",
		"expo-sharing": "~55.0.20",
		"expo-splash-screen": "~55.0.21",
		"expo-system-ui": "~55.0.18",
		"expo-updates": "~55.0.24",
		"expo-web-browser": "~55.0.16",
		"i18next": "^25.7.3",
		"nativewind": "^4.2.1",
		"react": "19.2.0",
		"react-dom": "19.2.0",
		"react-error-boundary": "^6.0.0",
		"react-i18next": "^16.5.0",
		"react-native": "0.83.6",
		"react-native-gesture-handler": "~2.30.0",
		"react-native-keyboard-aware-scroll-view": "^0.9.5",
		"react-native-reanimated": "4.2.1",
		"react-native-safe-area-context": "~5.6.0",
		"react-native-screens": "~4.23.0",
		"react-native-view-shot": "^5.1.0",
		"react-native-web": "^0.21.0",
		"react-native-webview": "13.16.0",
		"react-native-worklets": "0.7.4"
	},
	"devDependencies": {
		"@babel/core": "^7.25.2",
		"@types/jest": "^29.5.14",
		"@types/react": "~19.2.10",
		"babel-preset-expo": "~55.0.8",
		"dotenv": "^17.2.3",
		"eslint": "^9.39.4",
		"eslint-config-expo": "~55.0.1",
		"eslint-import-resolver-typescript": "^3.10.1",
		"html2canvas": "^1.4.1",
		"husky": "^9.1.7",
		"jest": "^29.7.0",
		"jest-expo": "~55.0.18",
		"knip": "^5.79.0",
		"patch-package": "^8.0.1",
		"prettier": "^3.7.4",
		"prettier-plugin-sort-json": "^4.1.1",
		"sort-package-json": "^3.6.0",
		"supabase": "^2.70.5",
		"tailwindcss": "^3.4.14",
		"typescript": "^6.0.3",
		"workbox-cli": "^7.4.0"
	},
	"expo": {
		"doctor": {
			"reactNativeDirectoryCheck": {
				"listUnknownPackages": false
			}
		},
		"install": {
			"exclude": [
				"react-native-view-shot",
				"typescript"
			]
		}
	}
}
