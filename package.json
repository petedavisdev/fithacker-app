{
	"name": "fithacker-app",
	"main": "expo-router/entry",
	"scripts": {
		"start": "expo start",
		"android": "expo start --android",
		"ios": "expo start --ios",
		"web": "expo start --web",
		"checks": "npm run lint && npm run format && npm run test",
		"test": "jest",
		"test:watch": "jest --watchAll",
		"lint": "expo lint",
		"format": "prettier --write .",
		"env:pull": "eas env:pull --environment development --output-file .env",
		"ios:sim": "eas build --profile=simulator --platform=ios",
		"ios:dev": "eas build --profile=development --platform=ios",
		"ios:pre": "eas build --profile=preview --platform=ios",
		"ios:prod": "eas build --platform=ios",
		"ios:submit": "eas submit --platform=ios",
		"ios:update:prod": "eas update --channel production",
		"web:build": "npx expo export --platform web",
		"web:pre": "eas deploy --alias preview",
		"web:prod": "eas deploy --prod",
		"supabase:login": "npx supabase login",
		"supabase:types": "npx supabase gen types typescript --project-id eujlarqrbwllnmxlhbsk > shared/supabase/database.types.ts",
		"supabase:status": "npx supabase projects list",
		"supabase:migrations": "npx supabase migration list --project-id eujlarqrbwllnmxlhbsk",
		"supabase:db:pull": "npx supabase db pull --project-id eujlarqrbwllnmxlhbsk",
		"supabase:db:diff": "npx supabase db diff --project-id eujlarqrbwllnmxlhbsk",
		"supabase:db:reset": "npx supabase db reset --project-id eujlarqrbwllnmxlhbsk",
		"supabase:logs:api": "npx supabase projects api-logs --project-id eujlarqrbwllnmxlhbsk",
		"supabase:logs:postgres": "npx supabase projects postgres-logs --project-id eujlarqrbwllnmxlhbsk",
		"supabase:logs:realtime": "npx supabase projects realtime-logs --project-id eujlarqrbwllnmxlhbsk"
	},
	"expo": {
		"doctor": {
			"reactNativeDirectoryCheck": {
				"listUnknownPackages": false
			}
		},
		"install": {
			"exclude": [
				"@types/jest",
				"@types/react",
				"react-native-webview",
				"react-native-worklets"
			]
		}
	},
	"jest": {
		"preset": "jest-expo"
	},
	"dependencies": {
		"@expo/vector-icons": "^15.0.3",
		"@react-native-async-storage/async-storage": "2.2.0",
		"@react-navigation/native": "^7.0.0",
		"@supabase/supabase-js": "^2.78.0",
		"@tanstack/react-query": "^5.90.12",
		"@tanstack/react-query-devtools": "^5.91.1",
		"expo": "^54.0.30",
		"expo-blur": "~15.0.8",
		"expo-clipboard": "~8.0.8",
		"expo-constants": "~18.0.12",
		"expo-dev-client": "~6.0.20",
		"expo-font": "~14.0.10",
		"expo-linear-gradient": "~15.0.8",
		"expo-linking": "~8.0.11",
		"expo-localization": "~17.0.8",
		"expo-network": "^8.0.8",
		"expo-router": "~6.0.21",
		"expo-sharing": "~14.0.8",
		"expo-splash-screen": "~31.0.13",
		"expo-status-bar": "~3.0.9",
		"expo-symbols": "~1.0.8",
		"expo-system-ui": "~6.0.9",
		"expo-updates": "~29.0.15",
		"expo-web-browser": "~15.0.10",
		"i18next": "^25.7.3",
		"nativewind": "^4.1.16",
		"react": "^19.1.4",
		"react-dom": "^19.1.4",
		"react-error-boundary": "^6.0.0",
		"react-i18next": "^16.5.0",
		"react-native": "^0.81.5",
		"react-native-gesture-handler": "~2.28.0",
		"react-native-keyboard-aware-scroll-view": "^0.9.5",
		"react-native-reanimated": "~4.1.1",
		"react-native-safe-area-context": "~5.6.0",
		"react-native-screens": "~4.16.0",
		"react-native-view-shot": "4.0.3",
		"react-native-web": "^0.21.0",
		"react-native-webview": "^13.16.0",
		"react-native-worklets": "^0.7.1"
	},
	"devDependencies": {
		"@babel/core": "^7.25.2",
		"@types/jest": "^29.5.14",
		"dotenv": "^17.2.3",
		"@types/react": "^19.2.7",
		"@types/react-test-renderer": "^19.1.0",
		"eslint": "^8.57.1",
		"eslint-config-expo": "~10.0.0",
		"jest": "^29.7.0",
		"jest-expo": "~54.0.16",
		"prettier": "^3.7.4",
		"react-test-renderer": "^19.1.4",
		"tailwindcss": "^3.4.14",
		"typescript": "~5.9.2"
	},
	"private": true
}
