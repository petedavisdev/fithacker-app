{
	"name": "fithacker-app",
	"main": "expo-router/entry",
	"scripts": {
		"start": "expo start",
		"android": "expo start --android",
		"ios": "expo start --ios",
		"web": "expo start --web",
		"checks": "npm run supabase:types && npm run verify:types && npm run lint && npm run test && npm run format && npm run supabase:db:diff",
		"test": "jest",
		"test:watch": "jest --watchAll",
		"lint": "expo lint",
		"format": "prettier --write . | grep -v '(unchanged)' || true",
		"format:check": "prettier --check .",
		"env:pull": "eas env:pull --environment development --path .env",
		"ios:sim": "eas build --profile=simulator --platform=ios",
		"ios:dev": "eas build --profile=development --platform=ios",
		"ios:pre": "eas build --profile=preview --platform=ios",
		"ios:prod": "eas build --platform=ios",
		"ios:submit": "eas submit --platform=ios",
		"ios:update:prod": "eas update --channel production",
		"web:build": "npx expo export --platform web && npx workbox-cli injectManifest workbox-config.js",
		"web:serve": "npx serve dist -p 8081 --single",
		"web:pre": "npm run web:build && npx eas-cli deploy --alias preview",
		"web:prod": "npm run web:build && npx eas-cli deploy --prod",
		"deploy:prod": "./scripts/deploy-prod.sh",
		"deploy:schema": "npx supabase db push --linked",
		"supabase:login": "npx supabase login",
		"supabase:types": "npx supabase gen types typescript --project-id eujlarqrbwllnmxlhbsk > shared/supabase/database.types.ts",
		"verify:types": "git diff --exit-code --quiet shared/supabase/database.types.ts || (echo '\nError: database.types.ts is out of sync with schema.\nThe types have been regenerated. Please review and commit the changes.\n' && exit 1)",
		"supabase:status": "npx supabase projects list",
		"supabase:migrations": "npx supabase migration list --project-id eujlarqrbwllnmxlhbsk",
		"supabase:schema:pull": "npx supabase db dump --linked -s public -f supabase/schemas/schema.sql",
		"supabase:schema:diff": "npx supabase db diff --linked -f",
		"supabase:db:diff": "npx supabase db diff --linked",
		"supabase:db:reset": "npx supabase db reset --project-id eujlarqrbwllnmxlhbsk",
		"supabase:logs:api": "npx supabase projects api-logs --project-id eujlarqrbwllnmxlhbsk",
		"supabase:logs:postgres": "npx supabase projects postgres-logs --project-id eujlarqrbwllnmxlhbsk",
		"supabase:logs:realtime": "npx supabase projects realtime-logs --project-id eujlarqrbwllnmxlhbsk"
	},
	"expo": {
		"doctor": {
			"reactNativeDirectoryCheck": {
				"listUnknownPackages": false
			}
		},
		"install": {
			"exclude": []
		}
	},
	"jest": {
		"preset": "jest-expo"
	},
	"dependencies": {
		"@expo/vector-icons": "^15.0.3",
		"@react-native-async-storage/async-storage": "2.2.0",
		"@react-navigation/native": "^7.0.0",
		"@supabase/supabase-js": "^2.78.0",
		"@tanstack/react-query": "^5.90.12",
		"@tanstack/react-query-devtools": "^5.91.1",
		"expo": "^54.0.30",
		"expo-blur": "~15.0.8",
		"expo-clipboard": "~8.0.8",
		"expo-constants": "~18.0.12",
		"expo-dev-client": "~6.0.20",
		"expo-font": "~14.0.10",
		"expo-linear-gradient": "~15.0.8",
		"expo-linking": "~8.0.11",
		"expo-localization": "~17.0.8",
		"expo-network": "^8.0.8",
		"expo-router": "~6.0.21",
		"expo-sharing": "~14.0.8",
		"expo-splash-screen": "~31.0.13",
		"expo-status-bar": "~3.0.9",
		"expo-symbols": "~1.0.8",
		"expo-system-ui": "~6.0.9",
		"expo-updates": "~29.0.15",
		"expo-web-browser": "~15.0.10",
		"i18next": "^25.7.3",
		"nativewind": "^4.1.16",
		"react": "19.1.0",
		"react-dom": "19.1.0",
		"react-error-boundary": "^6.0.0",
		"react-i18next": "^16.5.0",
		"react-native": "^0.81.5",
		"react-native-gesture-handler": "~2.28.0",
		"react-native-keyboard-aware-scroll-view": "^0.9.5",
		"react-native-reanimated": "~4.1.1",
		"react-native-safe-area-context": "~5.6.0",
		"react-native-screens": "~4.16.0",
		"react-native-view-shot": "4.0.3",
		"react-native-web": "^0.21.0",
		"react-native-webview": "13.15.0",
		"react-native-worklets": "0.5.1"
	},
	"devDependencies": {
		"@babel/core": "^7.25.2",
		"@types/jest": "^29.5.14",
		"@types/react": "~19.1.10",
		"@types/react-test-renderer": "^19.1.0",
		"dotenv": "^17.2.3",
		"eslint": "^8.57.1",
		"eslint-config-expo": "~10.0.0",
		"jest": "^29.7.0",
		"jest-expo": "~54.0.16",
		"prettier": "^3.7.4",
		"react-test-renderer": "19.1.0",
		"supabase": "^2.70.5",
		"tailwindcss": "^3.4.14",
		"typescript": "~5.9.2",
		"workbox-cacheable-response": "^7.4.0",
		"workbox-cli": "^7.4.0",
		"workbox-expiration": "^7.4.0",
		"workbox-precaching": "^7.4.0",
		"workbox-routing": "^7.4.0",
		"workbox-strategies": "^7.4.0"
	},
	"private": true
}
