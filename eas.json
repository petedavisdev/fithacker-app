{
	"build": {
		"development": {
			"channel": "development",
			"developmentClient": true,
			"distribution": "internal",
			"env": {
				"APP_VARIANT": "development"
			}
		},
		"preview": {
			"channel": "preview",
			"distribution": "internal",
			"env": {
				"APP_VARIANT": "preview"
			}
		},
		"production": {
			"autoIncrement": true,
			"channel": "production",
			"env": {
				"APP_VARIANT": "production"
			}
		},
		"screenshot": {
			"channel": "simulator",
			"developmentClient": false,
			"distribution": "internal",
			"env": {
				"APP_VARIANT": "development"
			},
			"ios": {
				"simulator": true
			}
		},
		"simulator": {
			"channel": "simulator",
			"developmentClient": true,
			"distribution": "internal",
			"env": {
				"APP_VARIANT": "development"
			},
			"ios": {
				"simulator": true
			}
		}
	},
	"cli": {
		"appVersionSource": "remote",
		"version": ">= 12.6.0"
	},
	"submit": {
		"production": {}
	}
}
